# Xcode
#
# gitignore-contributors:
# https://github.com/github/gitignore/blob/main/Global/Xcode.gitignore

# Ignore the Xcode project folder (created locally, not committed)
*.xcodeproj
*.xcworkspace

# Build generated
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.resolved

# Node (in case of hybrid apps)
node_modules/

# User-specific
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Content Studio
*.xcuser*
*.scenecache

# macOS
.DS_Store

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Interface Builder Local History
*.storyboardloc
*.xibloc

# Keychain
*.p12

# Secrets and credentials
*.pem
*.p12
*.key
credentials.json
.env*.local
